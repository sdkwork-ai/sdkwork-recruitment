# SDKWork private environment template. Copy to `.env` and fill values locally;
# never commit a resolved credential. The public application access token is
# materialized per profile by the canonical client env materializer.
SDKWORK_ACCESS_TOKEN=
SDKWORK_ENVIRONMENT=development
SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROFILE_ID=standalone.development

# Deploy application anchor. The registrar writes the installation's decimal
# deploy-application id here (or into `etc/topology/overrides/<profile>.env`) and
# re-runs the client env materializer; the public application access token's
# `app_id`/`aud` comes from this variable, never from a compiled-in literal
# (APP_ACCESS_TOKEN_SPEC.md §3.1.1). Leave it blank in this template.
SDKWORK_DEPLOY_APPLICATION_ID=
