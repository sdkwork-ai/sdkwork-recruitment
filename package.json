{
  "name": "sdkwork-recruitment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SDKWork Recruitment application initialized from the SDKWork scaffold.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sdkwork/sdk-common": "workspace:*"
  },
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "node scripts/sdkwork-command.mjs dev --deployment-profile standalone --environment development",
    "dev:cloud": "node scripts/sdkwork-command.mjs dev --deployment-profile cloud --environment development",
    "stop": "node scripts/sdkwork-command.mjs stop",
    "build": "node scripts/sdkwork-command.mjs build",
    "test": "node scripts/sdkwork-command.mjs test",
    "check": "node scripts/sdkwork-command.mjs check",
    "verify": "node scripts/sdkwork-command.mjs verify",
    "clean": "node scripts/sdkwork-command.mjs clean",
    "typecheck": "node scripts/sdkwork-command.mjs typecheck",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "check:workspace": "node ../sdkwork-specs/tools/check-workspace-layout.mjs --root .",
    "check:baseline": "node ../sdkwork-specs/tools/audit-repository-baseline.mjs --root .",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root .",
    "check:manifest": "node ../sdkwork-specs/tools/check-app-manifest-standard.mjs --root ."
  }
}
